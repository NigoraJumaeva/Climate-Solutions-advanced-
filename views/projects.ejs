<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <title>Projects | Climate Solutions</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="bg-base-100">

  <%- include('partials/navbar') %>

  <div class="container mx-auto p-6">

    <div class="hero bg-base-200 p-8 rounded-lg mb-8">
      <div class="hero-content text-center">
        <div>
          <h1 class="text-4xl font-bold">Projects</h1>
          <p>Select a sector or browse all solutions.</p>
        </div>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="table table-zebra w-full">
        <thead>
          <tr>
            <th>Title</th>
            <th>Sector</th>
            <th>Description</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% projects.forEach(project => { %>
            <tr>
              <td><%= project.title %></td>

              <td>
                <a href="/solutions/projects?sector=<%= project.sector %>" class="btn btn-sm">
                  <%= project.sector %>
                </a>
              </td>

              <td><%= project.summary_short %></td>

              <td>
                <a href="/solutions/projects/<%= project.id %>" class="btn btn-primary btn-sm">
                  Details
                </a>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

  </div>
</body>
</html>
