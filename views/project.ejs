<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <title><%= project.title %> | Climate Solutions</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body class="bg-base-100">

  <%- include('partials/navbar') %>

  <div class="container mx-auto p-6 prose max-w-3xl">

    <h1 class="text-4xl font-bold"><%= project.title %></h1>
    <p class="text-gray-500 italic">Viewing detailed information about this climate solution.</p>

    <img src="<%= project.feature_img_url %>" class="rounded-lg shadow-lg w-full my-6">

    <h2 class="font-semibold text-xl mt-8">Summary</h2>
    <p><%= project.intro_short %></p>

    <h2 class="font-semibold text-xl mt-8">Climate Impact</h2>
    <p><%= project.impact %></p>

    <h2 class="font-semibold text-xl mt-8">Learn More</h2>
    <p>
      <a class="btn btn-primary" href="<%= project.original_source_url %>" target="_blank">
        Visit Official Source
      </a>
    </p>

    <div class="mt-10 p-4 border rounded-lg bg-base-200">
      <blockquote id="quoteText" class="italic"></blockquote>
      <p class="text-right" id="quoteAuthor"></p>
    </div>

    <p class="mt-6">
      <a href="#" onclick="history.back(); return false;" class="btn btn-outline">Go Back</a>
    </p>

  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      fetch("https://dummyjson.com/quotes/random")
        .then(res => res.json())
        .then(data => {
          document.getElementById("quoteText").innerText = `"${data.quote}"`;
          document.getElementById("quoteAuthor").innerText = `- ${data.author}`;
        });
    });
  </script>

</body>
</html>
