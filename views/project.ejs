<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<title><%= project.title %></title>
<link rel="stylesheet" href="/css/main.css">
</head>
<body class="bg-base-100">
<%- include('partials/navbar') %>


<div class="container mx-auto p-6 prose max-w-3xl">


<h1 class="text-4xl font-bold"><%= project.title %></h1>
<p class="text-gray-500 italic">Project details</p>


<img src="<%= project.feature_img_url %>" class="rounded-lg shadow-lg w-full my-6">


<h2>Summary</h2>
<p><%= project.intro_short %></p>


<h2>Climate Impact</h2>
<p><%= project.impact %></p>


<h2>Source</h2>
<a class="btn btn-primary" href="<%= project.original_source_url %>" target="_blank">Open Source</a>


<% if (session.user) { %>
<p class="mt-6">
<a href="/solutions/editProject/<%= project.id %>" class="btn btn-success">Edit</a>
</p>
<% } %>


<p class="mt-6">
<a class="btn btn-outline" href="/solutions/projects">Back</a>
</p>
</div>
</body>
</html>