<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="UTF-8">
<title><%= project.title %></title>
<link rel="stylesheet" href="/css/main.css">
</head>
<body class="bg-base-100">
<%- include('partials/navbar') %>

<div class="container mx-auto p-6 prose max-w-3xl">

    <h1 class="text-4xl font-bold mb-2"><%= project.title %></h1>
    <p class="text-gray-500 italic mb-4">Project details</p>

    <% if(project.feature_img_url) { %>
        <img src="<%= project.feature_img_url %>" class="rounded-lg shadow-lg w-full my-6" alt="<%= project.title %>">
    <% } %>

    <h2>Summary</h2>
    <p><%= project.summary_short %></p>

    <h2>Introduction</h2>
    <p><%= project.intro_short %></p>

    <h2>Climate Impact</h2>
    <p><%= project.impact %></p>

    <h2>Source</h2>
    <a class="btn btn-primary mb-4" href="<%= project.original_source_url %>" target="_blank">Open Source</a>

    <% if (session.user) { %>
        <div class="flex gap-2 my-4">
            <a href="/solutions/editProject/<%= project.id %>" class="btn btn-success">Edit Project</a>
            <a href="/solutions/deleteProject/<%= project.id %>" class="btn btn-error" onclick="return confirm('Are you sure you want to delete this project?');">Delete Project</a>
        </div>
    <% } %>

    <a class="btn btn-outline mt-4" href="/solutions/projects">Back to Projects</a>

</div>
</body>
</html>
