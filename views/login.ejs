<%- include('partials/navbar') %>
<h1 class="text-3xl font-bold my-4">Login</h1>
<form action="/login" method="POST" class="space-y-4">
    <input type="text" name="userName" placeholder="User Name" value="<%= userName %>" required class="input input-bordered w-full"/>
    <input type="password" name="password" placeholder="Password" required class="input input-bordered w-full"/>
    <% if(errorMessage){ %>
        <div role="alert" class="alert alert-error">
            <span><%= errorMessage %></span>
        </div>
    <% } %>
    <button type="submit" class="btn btn-primary">Login</button>
</form>
