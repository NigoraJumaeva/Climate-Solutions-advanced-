<%- include('partials/navbar') %>

<div class="hero min-h-screen bg-base-200">
  <div class="hero-content w-full max-w-lg">
    <div class="card w-full shadow-2xl bg-base-100">
      <div class="card-body">
        <h2 class="card-title text-3xl mb-4">Edit Project</h2>
        <form action="/solutions/editProject" method="POST">
          <input type="hidden" name="id" value="<%= project.id %>">

          <div class="form-control">
            <label class="label">Title</label>
            <input type="text" name="title" value="<%= project.title %>" class="input input-bordered" required>
          </div>

          <div class="form-control">
            <label class="label">Feature Image URL</label>
            <input type="url" name="feature_img_url" value="<%= project.feature_img_url %>" class="input input-bordered" required>
          </div>

          <div class="form-control">
            <label class="label">Sector</label>
            <select name="sector_id" class="select select-bordered" required>
              <% sectors.forEach(sector => { %>
                <option value="<%= sector.id %>" <%= sector.id === project.Sector.id ? 'selected' : '' %>><%= sector.sector_name %></option>
              <% }) %>
            </select>
          </div>

          <div class="form-control">
            <label class="label">Introduction</label>
            <textarea name="intro_short" class="textarea textarea-bordered" required><%= project.intro_short %></textarea>
          </div>

          <div class="form-control">
            <label class="label">Summary</label>
            <textarea name="summary_short" class="textarea textarea-bordered" required><%= project.summary_short %></textarea>
          </div>

          <div class="form-control">
            <label class="label">Impact</label>
            <textarea name="impact" class="textarea textarea-bordered" required><%= project.impact %></textarea>
          </div>

          <div class="form-control">
            <label class="label">Original Source URL</label>
            <input type="url" name="original_source_url" value="<%= project.original_source_url %>" class="input input-bordered" required>
          </div>

          <div class="form-control mt-4 flex gap-2">
            <button type="submit" class="btn btn-success">Update Project</button>
            <a href="/solutions/deleteProject/<%= project.id %>" class="btn btn-error">Delete Project</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
